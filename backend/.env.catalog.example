# 复制为 backend/.env.catalog.local，填写两个不同的本机随机密码，不要提交真实值。
CATALOG_POSTGRES_PASSWORD=replace-with-local-owner-password
CATALOG_DATABASE_URL=postgresql://catalogowner:replace-with-local-owner-password@127.0.0.1:55432/openzltravelcatalog

# catalog.ps1 -ProvisionRuntime 使用该密码幂等创建只读 travelapp 账号。
TRAVELAPP_POSTGRES_PASSWORD=replace-with-local-reader-password
