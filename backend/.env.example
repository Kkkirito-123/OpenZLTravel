# 运行环境：development / test / production
APP_ENV=development

# 本地默认使用固定 dev-local 身份；production 禁止 dev 模式。
AUTH_MODE=dev
DEV_USER_ID=dev-local
AUTH_COOKIE_NAME=openzltravel_identity
AUTH_COOKIE_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
# signed 模式必须使用至少 32 字符的随机密钥；dev 模式可留空。
AUTH_SECRET=

# fake 只替换外部事实 Provider；Assistant 对话仍要求配置下方 LLM。live 还要求 Catalog 数据库。
PROVIDER_MODE=fake

# 只有独立 Assistant 使用 LLM；留空时明确报错，不退化为规则对话。
OPENAI_API_KEY=
OPENAI_BASE_URL=
TRAVEL_FAST_MODEL=gpt-5-mini
TRAVEL_PLANNER_MODEL=gpt-5

# PostGIS 地点目录；live 模式建议使用 catalog.ps1 创建的只读 travelapp 账号。
CATALOG_DATABASE_URL=
ALLOW_AMAP_FALLBACK=true

# 高德用于目录未命中、公交/实时驾车和天气兜底。
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=10

# Open-Meteo 不需要 API Key。
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=8

# 铁路数据源：public 直接调用 12306 公共查询接口；mcp 使用外部 MCP 服务。
RAIL_PROVIDER=public
RAIL_MCP_URL=http://127.0.0.1:8001/mcp
RAIL_MCP_TOKEN=
RAIL_MCP_TIMEOUT_SECONDS=12

# RollingGo 官方 Streamable HTTP MCP；Key 只放在 backend/.env，不写日志或 Store。
ROLLINGGO_MCP_URL=https://mcp.rollinggo.cn/mcp
ROLLINGGO_API_KEY=
ROLLINGGO_TIMEOUT_SECONDS=12
