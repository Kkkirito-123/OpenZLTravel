# 高德 Web 服务 API Key（后端使用）
AMAP_API_KEY=your_amap_api_key
AMAP_BASE_URL=https://restapi.amap.com/v3
AMAP_TIMEOUT_SECONDS=20
# 高德成功响应保存在 DATABASE_PATH 的 provider_cache 表中
AMAP_CACHE_TTL_SECONDS=86400
AMAP_MIN_INTERVAL_SECONDS=0.4
AMAP_RATE_LIMIT_COOLDOWN_SECONDS=30
AMAP_SCHEDULER_CONCURRENCY=2

# Open-Meteo 天气主来源；无需 API Key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=15

# OpenAI 兼容模型配置
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your_model_name
LLM_TIMEOUT_SECONDS=60
LLM_ENHANCEMENT_TIMEOUT_SECONDS=8
# 对话认知层：不设置生成 Token 上限，只记录用量并保留 SQLite 精确结果缓存
INTENT_LLM_TIMEOUT_SECONDS=15
INTENT_CONTEXT_MAX_CHARS=5000
INTENT_RESULT_CACHE_TTL_SECONDS=3600
# 仅在模型供应商明确兼容 OpenAI prompt_cache_key 时填写；普通兼容服务保持空值
INTENT_PROMPT_CACHE_KEY=
CONVERSATION_RECENT_TOKEN_LIMIT=3000
CONVERSATION_SUMMARY_TOKEN_LIMIT=800

# 12306 只读 MCP（需单独启动 mcp-server-12306 HTTP 服务）
RAIL_MCP_URL=http://127.0.0.1:8001/mcp
RAIL_MCP_TIMEOUT_SECONDS=12

# RollingGo 酒店 Skill：先执行 rgh login，项目复用其 OAuth 令牌
ROLLINGGO_HOTEL_BASE_URL=https://mcp.rollinggo.cn/mcp
ROLLINGGO_HOTEL_TOKEN_PATH=~/.hotel-cli/token.json
ROLLINGGO_HOTEL_TIMEOUT_SECONDS=12

# 兼容旧 DIDA 供应商 Token；OAuth 令牌不存在时才使用
DIDA_MCP_URL=https://mcp.rollinggo.cn/mcp
DIDA_API_KEY=your_dida_api_key
DIDA_MCP_TIMEOUT_SECONDS=12

# 外部 Provider 的共享稳定性参数
PROVIDER_CONCURRENCY=4
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_SECONDS=30

# 本地 SQLite 文件
DATABASE_PATH=db/openzltravel.sqlite3

# PostgreSQL 公共地点库；运行账号只需要 catalogreader 权限
CATALOG_DATABASE_URL=postgresql://travelapp:replace-me@127.0.0.1:55432/openzltravelcatalog
CATALOG_POOL_MIN_SIZE=1
CATALOG_POOL_MAX_SIZE=4
CATALOG_POOL_TIMEOUT_SECONDS=3
# 仅在回滚时显式开启；正常运行不会读取 CATALOG_PATH
CATALOG_SQLITE_ROLLBACK=false
CATALOG_PATH=data/catalog.sqlite3
ALLOW_AMAP_FALLBACK=true

# 前端高德 JS API Key（开发时也可放在 frontend/.env）
VITE_AMAP_JS_KEY=your_amap_js_key
